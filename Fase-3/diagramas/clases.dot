digraph Clases {
  graph [fontname="DejaVu Sans", fontsize=14, labelloc=t, label=<<b>Diagrama de clases - Tienda Virtual</b>>, nodesep=0.25, ranksep=0.45, splines=true, pad=0.2];
  node [shape=plain, fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8, color="#181818", arrowhead=none, labeldistance=1.6, labelangle=25];
  User [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>User</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- name: String<br/>- email: String<br/>- passwordHash: String<br/>- phone: String<br/>- active: boolean<br/>- createdAt: LocalDateTime</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ assignRole(role)<br/>+ hasRole(name): boolean<br/>+ canView(module): boolean<br/>+ checkCanLogIn()<br/>+ deactivate()</td></tr></table>>];
  Role [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Role</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- name: RoleName<br/>- description: String</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3"> </td></tr></table>>];
  Customer [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Customer</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- document: String<br/>- name: String<br/>- phone: String<br/>- email: String</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ updateData(...)<br/>+ hasAccount(): boolean</td></tr></table>>];
  Category [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Category</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- name: String</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3"> </td></tr></table>>];
  Product [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Product</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- code: String<br/>- name: String<br/>- description: String<br/>- price: BigDecimal<br/>- stock: int<br/>- active: boolean</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ checkAvailable(qty)<br/>+ isAvailable(qty): boolean<br/>+ deactivate()</td></tr></table>>];
  InventoryMovement [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>InventoryMovement</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- type: MovementType<br/>- quantity: int<br/>- notes: String<br/>- createdAt: LocalDateTime</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ entry(product, qty, user, notes)<br/>+ exit(product, qty, user, notes)</td></tr></table>>];
  Cart [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Cart</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ addProduct(product, qty)<br/>+ updateQuantity(product, qty)<br/>+ removeProduct(product)<br/>+ getTotal(): BigDecimal<br/>+ checkout(): Order</td></tr></table>>];
  CartItem [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>CartItem</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- quantity: int</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ getSubtotal(): BigDecimal</td></tr></table>>];
  InStoreSale [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>InStoreSale</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- lines: Map&lt;Product, Integer&gt;</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ addProduct(product, qty)<br/>+ changeQuantity(product, qty)<br/>+ removeProduct(product)<br/>+ getTotal(): BigDecimal<br/>+ confirm(): Order</td></tr></table>>];
  Order [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Order</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- channel: SalesChannel<br/>- status: OrderStatus<br/>- total: BigDecimal<br/>- createdAt: LocalDateTime</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ calculateTotal(): BigDecimal<br/>+ setDeliveryAddress(address)<br/>+ registerPayment(method): Payment<br/>+ advanceStatus(user)<br/>+ cancel(user)<br/>+ isPaid(): boolean</td></tr></table>>];
  OrderItem [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>OrderItem</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- quantity: int<br/>- unitPrice: BigDecimal</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ getSubtotal(): BigDecimal</td></tr></table>>];
  OrderStatusHistory [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>OrderStatusHistory</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- status: OrderStatus<br/>- changedAt: LocalDateTime</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3"> </td></tr></table>>];
  DeliveryAddress [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>DeliveryAddress</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- address: String<br/>- city: String<br/>- reference: String</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3"> </td></tr></table>>];
  PaymentMethod [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>PaymentMethod</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- name: String<br/>- active: boolean</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3"> </td></tr></table>>];
  Payment [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Payment</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- status: PaymentStatus<br/>- createdAt: LocalDateTime</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ approve()<br/>+ reject()</td></tr></table>>];
  Delivery [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Delivery</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- status: DeliveryStatus<br/>- incident: String<br/>- assignedAt: LocalDateTime<br/>- deliveredAt: LocalDateTime</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ assign(order, courier, seller)<br/>+ markOnTheWay(courier)<br/>+ confirmDelivered(courier)<br/>+ reportIncident(courier, text)</td></tr></table>>];
  Invoice [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#1F6F2B">Ⓒ</font> <b>Invoice</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">- id: Integer<br/>- invoiceNumber: String<br/>- subtotal: BigDecimal<br/>- tax: BigDecimal<br/>- total: BigDecimal<br/>- issuedAt: LocalDateTime</td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">+ generate(order, user, number, rate)<br/>+ canBeViewedBy(user): boolean</td></tr></table>>];
  RoleName [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#8B3A2F">Ⓔ</font> <b>RoleName</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">ADMIN<br/>SELLER<br/>INVENTORY_MANAGER<br/>BILLING_MANAGER<br/>CUSTOMER<br/>COURIER</td></tr></table>>];
  OrderStatus [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#8B3A2F">Ⓔ</font> <b>OrderStatus</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">PENDING<br/>IN_PREPARATION<br/>ON_THE_WAY<br/>DELIVERED<br/>CANCELLED</td></tr></table>>];
  SalesChannel [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#8B3A2F">Ⓔ</font> <b>SalesChannel</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">IN_STORE<br/>ONLINE</td></tr></table>>];
  PaymentStatus [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#8B3A2F">Ⓔ</font> <b>PaymentStatus</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">PENDING<br/>APPROVED<br/>REJECTED</td></tr></table>>];
  DeliveryStatus [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#8B3A2F">Ⓔ</font> <b>DeliveryStatus</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">ASSIGNED<br/>ON_THE_WAY<br/>DELIVERED</td></tr></table>>];
  MovementType [label=<<table border="1" cellborder="0" cellspacing="0" color="#181818" bgcolor="#F1F1F1"><tr><td align="center" bgcolor="#F1F1F1" cellpadding="4"><font point-size="11"><font color="#8B3A2F">Ⓔ</font> <b>MovementType</b></font></td></tr><hr/><tr><td align="left" balign="left" cellpadding="3">ENTRY<br/>EXIT</td></tr></table>>];
  User -> Role [taillabel="*", headlabel="1..*"];
  Customer -> User [label="cuenta", taillabel="0..1", headlabel="0..1"];
  Product -> Category [taillabel="*", headlabel="1"];
  InventoryMovement -> Product [taillabel="*", headlabel="1"];
  InventoryMovement -> User [label="registeredBy", taillabel="*", headlabel="1"];
  InventoryMovement -> Order [taillabel="*", headlabel="0..1"];
  Cart -> Customer [taillabel="0..1", headlabel="1"];
  Cart -> CartItem [taillabel="1", headlabel="*", dir=both, arrowtail=diamond];
  CartItem -> Product [taillabel="*", headlabel="1"];
  InStoreSale -> User [label="seller", taillabel="*", headlabel="1"];
  InStoreSale -> Customer [taillabel="*", headlabel="1"];
  InStoreSale -> Order [label="«create»", style=dashed, arrowhead=vee, color="#555555"];
  Cart -> Order [label="«create»", style=dashed, arrowhead=vee, color="#555555"];
  Order -> Customer [taillabel="*", headlabel="1"];
  Order -> User [label="seller", taillabel="*", headlabel="0..1"];
  Order -> OrderItem [taillabel="1", headlabel="1..*", dir=both, arrowtail=diamond];
  OrderItem -> Product [taillabel="*", headlabel="1"];
  Order -> OrderStatusHistory [taillabel="1", headlabel="1..*", dir=both, arrowtail=diamond];
  Order -> DeliveryAddress [taillabel="*", headlabel="0..1"];
  Order -> Payment [taillabel="1", headlabel="0..*"];
  Payment -> PaymentMethod [taillabel="*", headlabel="1"];
  Order -> Delivery [taillabel="1", headlabel="0..1"];
  Delivery -> User [label="courier", taillabel="*", headlabel="1"];
  Order -> Invoice [taillabel="1", headlabel="0..1"];
  Invoice -> User [label="issuedBy", taillabel="*", headlabel="1"];
  RoleName -> OrderStatus -> SalesChannel -> PaymentStatus -> DeliveryStatus -> MovementType [style=invis];
  Cart -> RoleName [style=invis];
}