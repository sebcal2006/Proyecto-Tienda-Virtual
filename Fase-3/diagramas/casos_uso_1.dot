digraph UC {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=14, labelloc=t, label=<<b>Casos de uso (1/2) - Personal interno</b>>, nodesep=0.12, ranksep=1.3, pad=0.2, imagepath="."];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#181818", arrowhead=vee, arrowsize=0.7];
  admin [shape=none, image="actor.png", label="Administrador", labelloc=b, width=0.9, height=1.55, fixedsize=true, imagepos=tc];
  seller [shape=none, image="actor.png", label="Vendedor", labelloc=b, width=0.9, height=1.55, fixedsize=true, imagepos=tc];
  inv [shape=none, image="actor.png", label="Encargado de\ninventario", labelloc=b, width=0.9, height=1.55, fixedsize=true, imagepos=tc];
  bill [shape=none, image="actor.png", label="Encargado de\nfacturación", labelloc=b, width=0.9, height=1.55, fixedsize=true, imagepos=tc];
  courier [shape=none, image="actor.png", label="Domiciliario", labelloc=b, width=0.9, height=1.55, fixedsize=true, imagepos=tc];
  subgraph cluster_sys { label=<<b>Tienda Virtual - Personal interno</b>>; fontsize=11; color="#181818"; style=solid; margin=14;
    login [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Iniciar sesión", margin="0.06,0.02"];
    users [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Gestionar usuarios", margin="0.06,0.02"];
    roles [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Asignar roles", margin="0.06,0.02"];
    pnew [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Registrar producto", margin="0.06,0.02"];
    pedit [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Modificar producto", margin="0.06,0.02"];
    poff [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Desactivar producto", margin="0.06,0.02"];
    orders [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Consultar pedidos", margin="0.06,0.02"];
    reports [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Consultar reportes", margin="0.06,0.02"];
    invq [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Consultar facturas", margin="0.06,0.02"];
    stockq [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Consultar inventario", margin="0.06,0.02"];
    clients [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Gestionar clientes\n(registrar/consultar/actualizar)", margin="0.06,0.02"];
    sale [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Registrar venta presencial", margin="0.06,0.02"];
    search [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Buscar producto\n(nombre/código)", margin="0.06,0.02"];
    saleedit [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Modificar/eliminar\nproducto de venta", margin="0.06,0.02"];
    saletotal [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Consultar total de venta", margin="0.06,0.02"];
    oedit [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Modificar pedido", margin="0.06,0.02"];
    ocancel [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Cancelar pedido", margin="0.06,0.02"];
    ostatus [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Actualizar estado\ndel pedido", margin="0.06,0.02"];
    assign [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Asignar domicilio", margin="0.06,0.02"];
    stockupd [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Actualizar existencias", margin="0.06,0.02"];
    entry [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Registrar entrada", margin="0.06,0.02"];
    exit [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Registrar salida", margin="0.06,0.02"];
    hist [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Consultar historial\nde movimientos", margin="0.06,0.02"];
    invgen [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Generar factura", margin="0.06,0.02"];
    assigned [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Consultar pedidos asignados", margin="0.06,0.02"];
    ontheway [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Marcar pedido en camino", margin="0.06,0.02"];
    deliver [shape=ellipse, style=filled, fillcolor="#F1F1F1", color="#181818", label="Confirmar entrega", margin="0.06,0.02"];
  }
  admin -> users [weight=2];
  admin -> roles [weight=2];
  admin -> pnew [weight=2];
  admin -> pedit [weight=2];
  admin -> poff [weight=2];
  admin -> orders [weight=2];
  admin -> reports [weight=2];
  admin -> invq [weight=2];
  admin -> stockq [weight=2];
  admin -> login [weight=2, constraint=false];
  seller -> clients [weight=2];
  seller -> sale [weight=2];
  seller -> saleedit [weight=2];
  seller -> saletotal [weight=2];
  seller -> orders [weight=2];
  seller -> oedit [weight=2];
  seller -> ocancel [weight=2];
  seller -> ostatus [weight=2];
  seller -> assign [weight=2];
  seller -> login [weight=2, constraint=false];
  inv -> stockupd [weight=2];
  inv -> entry [weight=2];
  inv -> exit [weight=2];
  inv -> stockq [weight=2];
  inv -> hist [weight=2];
  inv -> login [weight=2, constraint=false];
  bill -> invgen [weight=2];
  bill -> invq [weight=2];
  bill -> login [weight=2, constraint=false];
  courier -> assigned [weight=2];
  courier -> ontheway [weight=2];
  courier -> deliver [weight=2];
  courier -> login [weight=2];
  sale -> search [style=dashed, label="«include»"];
  saleedit -> sale [style=dashed, label="«extend»"];
}