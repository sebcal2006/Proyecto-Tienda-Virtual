graph Conceptual {
  graph [layout=neato, overlap=false, sep="+10", mode=major, start=3, splines=true, fontname="DejaVu Sans", fontsize=15, labelloc=t, label=<<b>Modelo conceptual (notación de Chen)</b>>, pad=0.3];
  node [fontname="DejaVu Sans", fontsize=10, color="#181818", style=filled];
  edge [fontname="DejaVu Sans", fontsize=9, color="#181818"];
  USR [shape=box, fillcolor="#DCE6F2", label="USUARIO", margin="0.15,0.08", penwidth=1.4];
  ROL [shape=box, fillcolor="#DCE6F2", label="ROL", margin="0.15,0.08", penwidth=1.4];
  CLI [shape=box, fillcolor="#DCE6F2", label="CLIENTE", margin="0.15,0.08", penwidth=1.4];
  CAT [shape=box, fillcolor="#DCE6F2", label="CATEGORÍA", margin="0.15,0.08", penwidth=1.4];
  PRO [shape=box, fillcolor="#DCE6F2", label="PRODUCTO", margin="0.15,0.08", penwidth=1.4];
  MOV [shape=box, fillcolor="#DCE6F2", label="MOVIMIENTO DE\nINVENTARIO", margin="0.15,0.08", penwidth=1.4];
  CAR [shape=box, fillcolor="#DCE6F2", label="CARRITO", margin="0.15,0.08", penwidth=1.4];
  PED [shape=box, fillcolor="#DCE6F2", label="PEDIDO", margin="0.15,0.08", penwidth=1.4];
  DIR [shape=box, fillcolor="#DCE6F2", label="DIRECCIÓN\nDE ENTREGA", margin="0.15,0.08", penwidth=1.4];
  MET [shape=box, fillcolor="#DCE6F2", label="MÉTODO\nDE PAGO", margin="0.15,0.08", penwidth=1.4];
  PAG [shape=box, fillcolor="#DCE6F2", label="PAGO", margin="0.15,0.08", penwidth=1.4];
  DOM [shape=box, fillcolor="#DCE6F2", label="DOMICILIO", margin="0.15,0.08", penwidth=1.4];
  FAC [shape=box, fillcolor="#DCE6F2", label="FACTURA", margin="0.15,0.08", penwidth=1.4];
  HIS [shape=box, fillcolor="#DCE6F2", label="HISTORIAL\nDE ESTADOS", margin="0.15,0.08", penwidth=1.4];
  r1 [shape=diamond, fillcolor="#F1F1F1", label="tiene", fontsize=9, margin="0.02,0.02"];
  USR -- r1 [label="N", len=1.0];
  r1 -- ROL [label="M", len=1.0];
  r2 [shape=diamond, fillcolor="#F1F1F1", label="corresponde a", fontsize=9, margin="0.02,0.02"];
  USR -- r2 [label="1", len=1.0];
  r2 -- CLI [label="0..1", len=1.0];
  r3 [shape=diamond, fillcolor="#F1F1F1", label="clasifica", fontsize=9, margin="0.02,0.02"];
  CAT -- r3 [label="1", len=1.0];
  r3 -- PRO [label="N", len=1.0];
  r4 [shape=diamond, fillcolor="#F1F1F1", label="afecta", fontsize=9, margin="0.02,0.02"];
  PRO -- r4 [label="1", len=1.0];
  r4 -- MOV [label="N", len=1.0];
  r5 [shape=diamond, fillcolor="#F1F1F1", label="registra", fontsize=9, margin="0.02,0.02"];
  USR -- r5 [label="1", len=1.0];
  r5 -- MOV [label="N", len=1.0];
  r6 [shape=diamond, fillcolor="#F1F1F1", label="posee", fontsize=9, margin="0.02,0.02"];
  CLI -- r6 [label="1", len=1.0];
  r6 -- CAR [label="0..1", len=1.0];
  r7 [shape=diamond, fillcolor="#F1F1F1", label="contiene", fontsize=9, margin="0.02,0.02"];
  CAR -- r7 [label="N", len=1.0];
  r7 -- PRO [label="M", len=1.0];
  r7_a [shape=ellipse, fillcolor="#FFFFFF", label="cantidad", fontsize=8, style="filled,dashed"];
  r7 -- r7_a [style=dashed, len=0.8];
  r8 [shape=diamond, fillcolor="#F1F1F1", label="realiza", fontsize=9, margin="0.02,0.02"];
  CLI -- r8 [label="1", len=1.0];
  r8 -- PED [label="N", len=1.0];
  r9 [shape=diamond, fillcolor="#F1F1F1", label="atiende\n(vendedor)", fontsize=9, margin="0.02,0.02"];
  USR -- r9 [label="0..1", len=1.0];
  r9 -- PED [label="N", len=1.0];
  r10 [shape=diamond, fillcolor="#F1F1F1", label="incluye", fontsize=9, margin="0.02,0.02"];
  PED -- r10 [label="N", len=1.0];
  r10 -- PRO [label="M", len=1.0];
  r10_a [shape=ellipse, fillcolor="#FFFFFF", label="cantidad,\nprecio unitario", fontsize=8, style="filled,dashed"];
  r10 -- r10_a [style=dashed, len=0.8];
  r11 [shape=diamond, fillcolor="#F1F1F1", label="se entrega en", fontsize=9, margin="0.02,0.02"];
  PED -- r11 [label="N", len=1.0];
  r11 -- DIR [label="0..1", len=1.0];
  r12 [shape=diamond, fillcolor="#F1F1F1", label="se paga con", fontsize=9, margin="0.02,0.02"];
  PED -- r12 [label="1", len=1.0];
  r12 -- PAG [label="N", len=1.0];
  r13 [shape=diamond, fillcolor="#F1F1F1", label="usa", fontsize=9, margin="0.02,0.02"];
  PAG -- r13 [label="N", len=1.0];
  r13 -- MET [label="1", len=1.0];
  r14 [shape=diamond, fillcolor="#F1F1F1", label="se despacha en", fontsize=9, margin="0.02,0.02"];
  PED -- r14 [label="1", len=1.0];
  r14 -- DOM [label="0..1", len=1.0];
  r15 [shape=diamond, fillcolor="#F1F1F1", label="entrega\n(domiciliario)", fontsize=9, margin="0.02,0.02"];
  USR -- r15 [label="1", len=1.0];
  r15 -- DOM [label="N", len=1.0];
  r16 [shape=diamond, fillcolor="#F1F1F1", label="genera", fontsize=9, margin="0.02,0.02"];
  PED -- r16 [label="1", len=1.0];
  r16 -- FAC [label="0..1", len=1.0];
  r17 [shape=diamond, fillcolor="#F1F1F1", label="emite\n(facturación)", fontsize=9, margin="0.02,0.02"];
  USR -- r17 [label="1", len=1.0];
  r17 -- FAC [label="N", len=1.0];
  r18 [shape=diamond, fillcolor="#F1F1F1", label="origina", fontsize=9, margin="0.02,0.02"];
  PED -- r18 [label="0..1", len=1.0];
  r18 -- MOV [label="N", len=1.0];
  r19 [shape=diamond, fillcolor="#F1F1F1", label="registra", fontsize=9, margin="0.02,0.02"];
  PED -- r19 [label="1", len=1.0];
  r19 -- HIS [label="N", len=1.0];
}